# Configuração local do Claude Code (permissões desta máquina)
.claude/settings.local.json
.claude/worktrees/

# Credenciais reais do Supabase: o modelo fica versionado, o preenchido fora
js/config.local.js
.env
.env.*
!.env.exemplo

# Relatórios de diagnóstico (podem conter dados de compra do usuário)
diagnostico-*.txt

# Dependências e artefatos
node_modules/
dist/
*.log

# Sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Backups exportados pelo app
compras-backup-*.json

# Notas fiscais de verdade NÃO entram no repositório: elas têm CNPJ, endereço
# e a lista de compras da casa. A fixture sintética em tests/fixtures cobre o
# mesmo defeito de leitura em 404 bytes.
*.pdf
!tests/fixtures/*.pdf

# Perfis do Chrome que a suite de abertura cria ao rodar - nunca versionados.
.tmp-chrome-*/
